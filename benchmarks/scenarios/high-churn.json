  "segmentDurationSeconds": 2,
  "uploadBandwidthLimit": 4,
  "concurrentUploadLimit": 3,
  "p2pTimeoutMs": 2000,
  "randomSeed": 12345,
  "repetitionCount": 1,
  "tags": [
    "high-churn",
    "fallback",
    "resilience"
  ]
}
