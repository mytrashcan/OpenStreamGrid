{
  "name": "openstreamgrid",
  "version": "0.5.0",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "workspaces": [
    "common",
    "tracker",
    "origin",
    "peer"
  ],
  "scripts": {
    "benchmark": "bash scripts/benchmark.sh",
    "benchmark:compare": "node scripts/benchmark-compare.mjs",
    "benchmark:report": "node scripts/benchmark-report.mjs",
    "benchmark:suite": "node scripts/benchmark-suite.mjs",
    "benchmark:update-readme": "node scripts/benchmark-update-readme.mjs",
    "build": "npm run build --workspaces --if-present && npm --prefix sdk run build",
    "lint": "eslint .",
    "test": "node --test test/*.test.mjs && npm run test --workspaces --if-present && npm --prefix sdk test && npm run test:scheduler-characterization",
    "test:scheduler-characterization": "tsc -p tsconfig.test.json && node --test dist-test/test/*scheduler-characterization.test.js",
    "test:docker-health": "bash test/docker-health-test.sh",
    "typecheck": "npm run typecheck --workspaces --if-present && npm --prefix sdk run typecheck"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^10.7.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
